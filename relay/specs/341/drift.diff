+
+/// A farmer of `people` carrying `carried` on (1, -2), two tiles from its festival at (1, 0), holding
+/// rich land around its home and the middle tile (1, -1): `farmer_beside_festival` one tile further out,
+/// so a step toward the festival reaps what staying does.
+fn farmer_two_from_festival(people: f64, carried: f64) -> (World, u32, usize, usize) {
+    let (mut w, _) = staged();
+    let fest = index(RADIUS, Hex { q: 1, r: 0 }).unwrap();
+    let home = index(RADIUS, Hex { q: 1, r: -2 }).unwrap();
+    let m = raise(&mut w, fest);
+    let land: Vec<usize> =
+        [(1, -2), (0, -2), (1, -3), (1, -1)].iter().map(|&(q, r)| index(RADIUS, Hex { q, r }).unwrap()).collect();
+    let id = clan(&mut w, home, &land, people);
+    for &t in &land {
+        w.tiles[t].stock = [500.0; engine::data::N];
+    }
+    let c = w.clans.get_mut(&id).unwrap();
+    c.fields = FIELD.farmer;
+    c.basket[GRAIN] = carried;
+    c.market = Some(m);
+    send(&mut w, id);
+    (w, id, home, fest)
+}
+
+#[test]
+fn a_farmer_two_tiles_out_steps_toward_its_festival_when_that_feeds_it_as_well_and_walks_less() {
+    let (w, id, home, fest) = farmer_two_from_festival(150.0, 30.0);
+    let to = chosen(&w, id);
+    assert_ne!(to, home, "the step toward the festival feeds it as well and walks it less");
+    assert_eq!(engine::land::steps(&w, to, fest), 1, "one tile nearer, not onto the festival yet");
+    let (empty, id, home, _) = farmer_two_from_festival(150.0, 0.0);
+    assert_eq!(chosen(&empty, id), home, "with nothing to carry the step feeds it less: it stays");
+}
+
+#[test]
+fn a_farmer_two_tiles_out_stays_when_the_step_toward_its_festival_feeds_it_less() {
+    let (mut w, id, home, _) = farmer_two_from_festival(150.0, 30.0);
+    // Its land lies on the far side of its home: a step toward the festival trims it away.
+    for (q, r) in [(0, -1), (1, -1), (2, -2), (2, -1)] {
+        w.tiles[index(RADIUS, Hex { q, r }).unwrap()].stock = [0.0; engine::data::N];
+    }
+    let c = w.clans.get_mut(&id).unwrap();
+    c.territory = vec![home];
+    assert_eq!(chosen(&w, id), home, "a step that feeds it less is not taken");
+}
