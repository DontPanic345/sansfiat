+/// Probe: the people who walk a clan's festival route: those carrying what it brought last turn.
+pub fn walkers(c: &Clan) -> f64 {
+    let load: f64 = std::env::var("LOAD").ok().and_then(|v| v.parse().ok()).unwrap_or(1.0);
