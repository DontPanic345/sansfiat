 }
+
+fn probe(w: &mut World, civ: u32) {
+    use crate::units::{givers, pack_cap};
+    let want: u32 = std::env::var("PROBE").unwrap().parse().unwrap_or(4);
+    w.civs.get_mut(&civ).unwrap().keep = Some(CIV.store_cap);
+    let fillable = |w: &World| ((total(&w.civs[&civ].store) / pack_cap(1.0)).floor() as u32).min(givers(w, civ).len() as u32);
+    if camp(w, civ).is_none() && fillable(w) >= want {
+        let mut into = None;
+        loop {
+            let n = fillable(w);
+            if n == 0 || w.order(civ, Order::Raise { n, kind: UnitKind::Camp, fighter: Fighter::Warriors, into }).is_err() { break; }
+            into = camp(w, civ).map(|u| u.id);
+        }
+        if let Some(id) = into { let _ = w.order(civ, Order::Switches { unit: id, forage: true, supply: true }); }
+    }
+    let cap = w.civs[&civ].capital;
+    let Some(target) = civs::alive(w).filter(|c| c.id != civ).min_by_key(|c| (steps(w, cap, c.capital), c.id)).map(|c| c.capital) else { return };
+    let Some(u) = camp(w, civ) else { return };
+    let (id, home, marching) = (u.id, u.home, u.camp().is_some_and(|c| c.dest.is_some()));
+    if !marching && home != target { let _ = w.order(civ, Order::Move { unit: id, to: target }); }
+}
