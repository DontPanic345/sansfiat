diff --git a/engine/core/src/herds.rs b/engine/core/src/herds.rs
new file mode 100644
index 0000000..02818f1
--- /dev/null
+++ b/engine/core/src/herds.rs
@@ -0,0 +1,94 @@
+//! Probe: herds.
+use crate::clans::{self, Clan};
+use crate::data::*;
+use crate::events::{Event, EventKind};
+use crate::world::World;
+
+pub struct HerdRules { pub graze: [f64; 8], pub tend: f64, pub breed: f64, pub start: f64, pub lean: f64,
+    pub notch: f64, pub margin: f64, pub herder: f64, pub radius: i32, pub walk: f64 }
+pub const HERD: HerdRules = HerdRules {
+    graze: [0.0, 1.0, 6.0, 1.0, 4.0, 0.0, 1.0, 2.0],
+    tend: 3.0, breed: 0.3, start: 0.5, lean: 0.25, notch: 0.1, margin: 0.01, herder: 0.2, radius: 3, walk: 0.5,
+};
+
+fn env(k: &str, d: f64) -> f64 { std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d) }
+pub fn tend() -> f64 { env("H_TEND", HERD.tend) }
+pub fn breed_rate() -> f64 { env("H_BREED", HERD.breed) }
+pub fn walkw() -> f64 { env("H_WALK", HERD.walk) }
+pub fn gscale() -> f64 { env("H_GRAZE", 1.0) }
+pub fn rad() -> i32 { env("H_RADIUS", HERD.radius as f64) as i32 }
+
+pub fn open(w: &World) -> bool { w.config.herds && !w.civs.is_empty() }
+
+pub fn graze(w: &World, i: usize) -> f64 {
+    let t = &w.tiles[i];
+    if !TERRAIN[t.terrain].land { return 0.0; }
+    HERD.graze[t.terrain] * gscale() * t.fertility
+}
+
+pub fn carries(w: &World, tiles: &[usize], days: &[f64]) -> f64 {
+    tiles.iter().zip(days).map(|(&t, &d)| graze(w, t).min(d * tend())).sum()
+}
+
+pub fn breed(h: f64, k: f64) -> f64 {
+    if k <= 0.0 { return -h * breed_rate().min(1.0); }
+    let inc = breed_rate() * h * (1.0 - h / k);
+    if h > k { inc.max(k - h) } else { inc }
+}
+
+pub fn herder(c: &Clan) -> bool { c.herds >= HERD.herder - 1e-9 }
+pub fn radius(c: &Clan) -> i32 { if herder(c) { rad() } else { CLAN.territory_radius } }
+
+/// The game on the clan's own tiles it could catch to start a herd.
+fn game_on(w: &World, c: &Clan) -> f64 {
+    c.territory.iter().filter(|&&t| w.tiles[t].claim == Some(c.id)).map(|&t| w.tiles[t].stock[GAME]).sum()
+}
+pub fn head_of(w: &World, id: u32, people: f64, store: &Basket, herds: f64) -> f64 {
+    if store[ANIMALS] > 0.0 || herds <= 0.0 { return store[ANIMALS]; }
+    match w.clans.get(&id) { Some(c) => (HERD.start * people).min(game_on(w, c)), None => 0.0 }
+}
+use crate::market::Basket;
+
+pub fn start(w: &mut World, id: u32) {
+    let c = w.clans[&id].clone();
+    if c.store[ANIMALS] > 0.0 { return; }
+    let game = game_on(w, &c);
+    let want = HERD.start * c.people;
+    let take = want.min(game);
+    if std::env::var("H_FREE").is_ok() { w.clans.get_mut(&id).unwrap().store[ANIMALS] = want; }
+    if take <= 0.0 { return; }
+    for &t in &c.territory {
+        if w.tiles[t].claim == Some(id) {
+            let s = w.tiles[t].stock[GAME];
+            w.tiles[t].stock[GAME] = s - take * s / game;
+        }
+    }
+    if std::env::var("H_FREE").is_err() { w.clans.get_mut(&id).unwrap().store[ANIMALS] = take; }
+}
+
+pub fn notch(w: &mut World, id: u32) {
+    if !open(w) { return; }
+    let c = w.clans[&id].clone();
+    if c.fields > 0.0 && c.herds <= 0.0 { return; }
+    let n = HERD.notch;
+    let v = |w: &World, s: f64| { let mut k = c.clone(); k.herds = s; clans::value(w, &k, &k.territory) };
+    let next = if c.starving && c.herds > 0.0 { (c.herds - n).max(0.0) } else {
+        let bar = v(w, c.herds) + HERD.margin;
+        if std::env::var("H_DEBUG").is_ok() && w.turn % 50 == 0 {
+            let up = v(w, (c.herds + n).min(1.0));
+            let hk = c.territory.iter().filter(|&&t| graze(w, t) > 0.0).count();
+            eprintln!("t{} clan {} p{:.1} terr {} grass {} herds {:.1} fields {:.1} starving {} now {:.3} up {:.3} game {:.1} head {:.2}",
+                w.turn, id, c.people, c.territory.len(), hk, c.herds, c.fields, c.starving, bar - HERD.margin, up, game_on(w, &c), head_of(w, id, c.people, &c.store, 0.1));
+        }
+        let fed_ok = std::env::var("H_FED").is_err() || c.fed;
+        let up = (fed_ok && c.herds < 1.0 - 1e-9).then(|| (c.herds + n).min(1.0)).map(|s| (s, v(w, s))).filter(|&(_, x)| x > bar);
+        let down = (c.herds > 1e-9).then(|| (c.herds - n).max(0.0)).map(|s| (s, v(w, s))).filter(|&(_, x)| x > bar);
+        match (up, down) { (Some(u), Some(d)) => if u.1 >= d.1 { u.0 } else { d.0 }, (Some(u), None) => u.0, (None, Some(d)) => d.0, _ => c.herds }
+    };
+    if next == c.herds { return; }
+    w.clans.get_mut(&id).unwrap().herds = next;
+    if c.herds <= 0.0 && next > 0.0 {
+        start(w, id);
+        w.emit(Event::new(EventKind::ClanFarming, c.home).clan(id));
+    }
+}
