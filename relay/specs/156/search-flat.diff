+/// Scratch: cost_map from `home` on flat scratch arrays, stopping once every festival that could be in reach is settled.
+pub fn festival_costs(w: &World, home: usize, most: f64) -> BTreeMap<usize, f64> {
+    use std::collections::BinaryHeap;
+    use std::cmp::Reverse;
+    thread_local! { static SCR: std::cell::RefCell<(Vec<(i64, f64)>, Vec<usize>)> = std::cell::RefCell::new((Vec::new(), Vec::new())); }
+    let cheapest = 0.75 * DAY;
+    let h = w.tiles[home].hex();
+    let mut want: Vec<usize> = w.markets.values().map(|m| m.tile)
+        .filter(|&t| f64::from(w.tiles[t].hex().distance(h)) * cheapest <= most + 1e-9).collect();
+    let limit = crate::land::grid(most);
+    let mut out = BTreeMap::new();
+    if want.is_empty() { return out; }
+    SCR.with(|s| {
+        let (best, touched) = &mut *s.borrow_mut();
+        if best.len() != w.tiles.len() { *best = vec![(i64::MAX, 0.0); w.tiles.len()]; }
+        let mut heap = BinaryHeap::new();
+        best[home] = (0, 0.0); touched.push(home);
+        heap.push(Reverse((0i64, home)));
+        while let Some(Reverse((g, i))) = heap.pop() {
+            let (bg, c) = best[i];
+            if g > bg { continue; }
+            if let Some(k) = want.iter().position(|&t| t == i) { want.swap_remove(k); out.insert(i, c); if want.is_empty() { break; } }
+            for j in crate::land::neighbours(w, i) {
+                let Some(step) = crate::land::step_cost(w, i, j) else { continue };
+                let nc = c + step;
+                let ng = crate::land::grid(nc);
+                if ng > limit || !passable(w, j) || best[j].0 <= ng { continue; }
+                if best[j].0 == i64::MAX { touched.push(j); }
+                best[j] = (ng, nc);
+                heap.push(Reverse((ng, j)));
+            }
+        }
+        for &t in touched.iter() { best[t] = (i64::MAX, 0.0); }
+        touched.clear();
+    });
+    out
+}
