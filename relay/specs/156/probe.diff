+/// SKETCH: a farmer steps its home one tile toward its festival when that feeds it better.
+fn town_step(w: &World, c: &Clan, home: usize, territory: Vec<usize>) -> (usize, Vec<usize>) {
+    if !fields::open(w) || !fields::farmer(c) {
+        return (home, territory);
+    }
+    let Some(t) = c.market.and_then(|m| w.markets.get(&m)).map(|m| m.tile) else { return (home, territory) };
+    if t == home {
+        return (home, territory);
+    }
+    let d = steps(w, home, t);
+    let Some(n) = neighbours(w, home).filter(|&n| TERRAIN[w.tiles[n].terrain].land && passable(w, n) && steps(w, n, t) < d).min() else {
+        return (home, territory);
+    };
+    let mut cand = territory.clone();
+    if let Err(k) = cand.binary_search(&n) {
+        cand.insert(k, n);
+    }
+    let cand = actors::trim(w, n, &cand, CLAN.territory_radius);
+    let walkers = crate::markets::walkers(c);
+    let Some((p, cost)) = crate::land::path(w, n, t, |i| passable(w, i)) else { return (home, territory) };
+    let routes = vec![Route { to: t, path: p, cost: actors::walk_cost(cost, 1.0) * walkers }];
+    let now = worth(w, c.people, &c.store, &c.routes, home, &territory, c.fields);
+    let then = worth(w, c.people, &c.store, &routes, n, &cand, c.fields);
+    let margin: f64 = std::env::var("TOWNM").ok().and_then(|v| v.parse().ok()).unwrap_or(0.01);
+    if then > now + margin {
+        (n, cand)
+    } else {
+        (home, territory)
+    }
+}
